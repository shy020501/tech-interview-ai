# Application: use the same origin as your browser and Supabase Auth redirect settings.
# For this SSH development setup: http://localhost:3001
NEXT_PUBLIC_APP_URL=

# Supabase: Project URL and publishable key. A legacy anon key can be placed in
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY if the existing project still uses one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# No Supabase service-role key. Admin uses the signed-in profile and RLS.
# M4-B evaluator RPCs additionally require a server capability, never NEXT_PUBLIC_.
# Run pnpm eval:setup live (or mock for explicit development testing).
# Apply the migration through the existing migration workflow, then the generated
# artifacts/evals/setup/runtime-capability.sql through trusted SQL. See docs/EVALUATOR.md.
# Missing mode/config fails closed. Mock is disallowed when NODE_ENV=production.
EVALUATOR_MODE=
EVALUATOR_RUNTIME_SECRET=
# Optional overrides; empty uses the user's registry default/difficult selection.
PRIMARY_EVALUATOR_PROFILE=
ESCALATION_EVALUATOR_PROFILE=

# Shared live runtime / explicit CLI benchmark adapter configuration.
# Set the provider's HTTPS API base, usually ending in /v1; do not append /chat/completions.
# The configured Luna medium/xhigh profiles both use provider A:
# EVAL_PROVIDER_A_BASE_URL should be https://api.openai.com/v1 in your local environment.
# EVAL_PROVIDER_A_API_KEY is your OpenAI API key; the two profiles can share it.
EVAL_PROVIDER_A_BASE_URL=
EVAL_PROVIDER_A_API_KEY=
EVAL_PROVIDER_B_BASE_URL=
EVAL_PROVIDER_B_API_KEY=

# Provisional defaults, configurable centrally; empty uses the documented default.
# Max characters: 4000 (1-20000). Shared by live input and benchmark input.
MAX_EVALUATION_MESSAGE_CHARS=
# Live: user/minute 12, attempt/minute 6; successful evaluations per attempt 100/day 300.
MAX_EVALUATIONS_PER_MINUTE=
MAX_ATTEMPT_EVALUATIONS_PER_MINUTE=
MAX_EVALUATIONS_PER_ATTEMPT=
MAX_EVALUATIONS_PER_DAY=
# Escalation requests/day 20; all reserved provider requests/day 1000 (including errors).
MAX_ESCALATIONS_PER_DAY=
MAX_PROVIDER_REQUESTS_PER_DAY=
# Consecutive off-topic/injection threshold 3, cooldown 60 seconds.
ABUSE_STRIKE_THRESHOLD=
ABUSE_COOLDOWN_SECONDS=
# User retries per saved failed message 2 (0-3); structured retries per role 0 (0-1).
MAX_EVALUATION_RETRIES=
EVALUATOR_STRUCTURED_RETRIES=
# Offline benchmark concurrency default 1, independent of live per-attempt ordering.
BENCHMARK_CONCURRENCY=

# User-selected medium/default and xhigh/difficult profiles: config/evaluator-profiles.json.
# Generic disabled profile template for other providers: config/evaluator-profiles.example.json.
# Real values belong in ignored .env.local or a deployment secret store.
# Never prefix a secret with NEXT_PUBLIC_. Never put real values in this file.
