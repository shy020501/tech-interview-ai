# Application: use the same origin as your browser and Supabase Auth redirect settings.
# For this SSH development setup: http://localhost:3001
NEXT_PUBLIC_APP_URL=

# Supabase: Project URL and publishable key. A legacy anon key can be placed in
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY if the existing project still uses one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# No service-role or secret key is required by this application's runtime.
# Admin access uses the signed-in user's database profile and RLS.

# LLM: future only; no provider is connected in M2.
AUTHORING_PROVIDER=
AUTHORING_MODEL=
EVALUATOR_PROVIDER=
EVALUATOR_MODEL=
ESCALATION_PROVIDER=
ESCALATION_MODEL=

# Provider-specific secret names will be added only after provider selection.
# Real values belong in ignored .env.local or a deployment secret store.
# Never prefix a secret with NEXT_PUBLIC_. Never put real values in this file.
